<?xml version="1.0"?>
<ruleset name="Trasparenza PA">
	<description>Standard di codifica del componente: WordPress Coding Standards.</description>

	<file>.</file>

	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/vendor-prefixed/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="trasparenza-pa"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="trasparenza_pa"/>
				<element value="TrasparenzaPa"/>
				<element value="TRASPARENZA_PA"/>
			</property>
		</properties>
	</rule>

	<!-- Nei test i nomi di file seguono la convenzione di PHPUnit, non quella dei file del componente. -->
	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="strict_class_file_names" value="false"/>
		</properties>
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!--
		L'avvio della suite e gli script di bin/ girano da riga di comando senza
		WordPress: WP_Filesystem non esiste e la diagnostica va su STDERR.
	-->
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_fwrite">
		<exclude-pattern>/tests/bootstrap*\.php</exclude-pattern>
		<exclude-pattern>/tests/avvio-comune\.php</exclude-pattern>
		<exclude-pattern>/bin/*\.php</exclude-pattern>
	</rule>

	<!--
		Nei test valgono regole diverse. Eseguire un aggancio di WordPress e cio
		che una prova deve fare per osservare un avviso in bacheca, e il prefisso
		obbligatorio riguarda gli agganci che il componente dichiara. Le
		operazioni su file passano dalle funzioni di PHP perche l'astrazione di
		WordPress sul filesystem, in un test, non rende la prova piu vera.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedHooknameFound">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!--
		Un avvio della suite definisce la costante della versione di interfaccia
		del componente comune prima che quel componente si carichi: la costante e
		di quel componente, quindi non porta il nostro prefisso.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedConstantFound">
		<exclude-pattern>/tests/bootstrap-core-incompatibile\.php</exclude-pattern>
	</rule>
</ruleset>
