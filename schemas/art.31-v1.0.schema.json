{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://guida-servizi.anticorruzione.it/help/trasparenza/schemi/json/art.31-v1.0.schema.json",
    "type": "object",
    "title": "Obblighi di pubblicazione concernenti i dati relativi ai controlli sull'organizzazione e sull'attività dell'amministrazione (art. 31 d.lgs. 33/2013)",
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "$ref": "https://guida-servizi.anticorruzione.it/help/trasparenza/schemi/json/commons-v1.0.schema.json#/definitions/Url"
        },
        "intestazione": {
            "$ref": "https://guida-servizi.anticorruzione.it/help/trasparenza/schemi/json/commons-v1.0.schema.json#/definitions/Intestazione"
        },
        "attiOrganiDiValutazione": {
            "$ref": "#/definitions/AttiOrganismoDiValutazione"
        },
        "attiOrganiDiRevisione": {
            "$ref": "#/definitions/OrganiDiRevisione"
        },
        "attiOrganiDiControllo": {
            "$comment": "Schemi di pubblicazione “Organi di controllo”",
            "$ref": "#/definitions/OrganiDiControllo"
        }        
    },
    "oneOf": [
        {
            "required": [
                "$schema",
                "intestazione",
                "attiOrganiDiValutazione"
            ]
        },
        {
            "required": [
                "$schema",
                "intestazione",
                "attiOrganiDiRevisione"
            ]
        },
        {
            "required": [
                "$schema",
                "intestazione",
                "attiOrganiDiControllo"
            ]
        }
    ],
    "definitions": {
        "AttiOrganismoDiValutazione": {
            "type": "object",
            "description": "Schema di pubblicazione “OIV o organismo analogo” (per gli enti tenuti)",
            "additionalProperties": false,
            "properties": {
                "validazioneRelazioneSullaPerformance": {
                    "$comment": "Documento dell'OIV di validazione della Relazione sulla Performance",
                    "$ref": "#/definitions/DatiIdentificativiDocumento"
                },
                "relazioneSistemaDiValutazione": {
                    "$comment": "Relazione dell'OIV sul funzionamento complessivo del Sistema di valutazione, trasparenza e integrita' dei controlli interni",
                    "$ref": "#/definitions/DatiIdentificativiDocumento"
                },
                "altriAttiOrganismoAnalogo": {
                    "$comment": "Altri atti degli organismi indipendenti di valutazione, nuclei di valutazione o altri organismi con funzioni analoghe (se adottati)",
                    "$ref": "#/definitions/DatiIdentificativiDocumento"
                }
            }
        },
        "OrganiDiRevisione": {
            "type": "object",
            "description": "Schema di pubblicazione “Organi di revisione”",
            "additionalProperties": false,
            "properties": {
                "relazioneBilancioDiPrevisione": {
                    "$comment": "Relazioni degli organi di revisione amministrativa e contabile al bilancio di previsione o budget e alle relative variazioni",
                    "$ref": "#/definitions/DatiIdentificativiDocumento"
                },
                "relazioneContoConsuntivo": {
                    "$comment": "Relazioni degli organi di revisione amministrativa e contabile al conto consuntivo o al bilancio di esercizio",
                    "$ref": "#/definitions/DatiIdentificativiDocumento"
                }
            },
            "required": [
                "relazioneBilancioDiPrevisione"
            ]
        },        
        "OrganiDiControllo": {
            "type": "object",
            "description": "Schema di pubblicazione “Organi di controllo”",
            "additionalProperties": false,
            "properties": {
                "rilieviCorteDeiConti": {
                    "description": "Rilievi della Corte dei conti riguardanti l'organizzazione e l'attività delle amministrazioni stesse e dei loro uffici",
                    "type": "array",
                    "minItems": 1,
                    "items": [
                        {
                            "$ref": "#/definitions/RilievoCorteDeiConti"
                        }
                    ]
                }
            },
            "required": [
                "rilieviCorteDeiConti"
            ]
        },
        "RilievoCorteDeiConti": {
            "type": "object",
            "description": "Rilievi della Corte dei conti riguardanti l'organizzazione e l'attività delle amministrazioni stesse e dei loro uffici",
            "additionalProperties": false,
            "properties": {
                "dataPubblicazione": {
                    "$comment": "Data di pubblicazione del rilievo della Corte dei Conti",
                    "$ref": "https://guida-servizi.anticorruzione.it/help/trasparenza/schemi/json/commons-v1.0.schema.json#/definitions/Data"
                },
                "oggetto": {
                    "$comment": "Atto oggetto del rilievo",
                    "$ref": "#/definitions/OggettoRilievoCorteDeiConti"
                },
                "documento": {
                    "$comment": "Link al documento sui rilievi della Corte dei Conti",
                    "$ref": "https://guida-servizi.anticorruzione.it/help/trasparenza/schemi/json/commons-v1.0.schema.json#/definitions/Url"
                }
            },
            "required": [
                "dataPubblicazione",
                "oggetto",
                "documento"
            ]
        },
        "OggettoRilievoCorteDeiConti": {
            "enum": [
                "Organizzazione",
                "Attivita'",
                "Entrambe"
            ]
        },
        "DatiIdentificativiDocumento": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "dataPubblicazione": {
                    "$comment": "Data di pubblicazione del documento nel sito istituzionale",
                    "$ref": "https://guida-servizi.anticorruzione.it/help/trasparenza/schemi/json/commons-v1.0.schema.json#/definitions/Data"
                },
                "documento": {
                    "$comment": "URL di pubblicazione del documento nel sito istituzionale",
                    "$ref": "https://guida-servizi.anticorruzione.it/help/trasparenza/schemi/json/commons-v1.0.schema.json#/definitions/Url"
                }
            },
            "required": [
                "dataPubblicazione",
                "documento"
            ]
        }
    }
}