{
    "name": "sitoalpasso/trasparenza-pa",
    "description": "Obblighi di pubblicazione della sezione Amministrazione trasparente per WordPress",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "config": {
        "platform": {
            "php": "8.1"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "test": "phpunit",
        "test:senza-core": "phpunit --configuration phpunit-senza-core.xml.dist",
        "test:core-incompatibile": "phpunit --configuration phpunit-core-incompatibile.xml.dist"
    }
}
